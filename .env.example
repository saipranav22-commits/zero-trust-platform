# Environment variables for Zero Trust Platform
# Copy this file to .env and fill in your values

# ─── Gemini AI ────────────────────────────────────────────────
# Set to true to enable AI-powered security assistant
GEMINI_AI_ENABLED=false

# Your Google Gemini API key (get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=

# ─── Database ─────────────────────────────────────────────────
# Override if running without Docker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zerotrust_db
POSTGRES_USER=zerotrust
POSTGRES_PASSWORD=

# ─── JWT (REQUIRED) ──────────────────────────────────────────
# Cryptographic secret for signing HS256 JWT tokens. Must be >= 32 characters (256 bits).
# To generate a production secret: openssl rand -base64 32
#
# ROTATION PROCEDURE:
# 1. Generate a new 256-bit secret.
# 2. Update JWT_SECRET in production environment / secret manager.
# 3. Restart the backend service. All existing access tokens become immediately invalid.
# 4. Truncate or invalidate active refresh tokens in database:
#    UPDATE refresh_tokens SET revoked = true WHERE revoked = false;
# 5. Clients will receive 401 and redirect to /login to establish fresh authenticated sessions.
JWT_SECRET=

# ─── Data Encryption (REQUIRED for Field-Level AES-256-GCM) ──
# 256-bit AES master key in Base64 (must decode to exactly 32 bytes).
# Generate: openssl rand -base64 32
#
# KEY ROTATION PROCEDURE:
# 1. Ciphertexts use a version prefix (e.g. 'v1:<base64-payload>').
# 2. To rotate, deploy new secondary key as 'v2' in KMS / environment.
# 3. Read operations decrypt using key matching version tag; write operations re-encrypt using active primary key.
# 4. Run an asynchronous batch migration job to re-encrypt all existing 'v1' records with 'v2'.
# 5. Once migration completes, retire 'v1' key.
ENCRYPTION_KEY=
